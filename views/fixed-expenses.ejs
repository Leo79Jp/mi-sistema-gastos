<%- include('partials/header') %>

<div class="dashboard-container">
    <section class="form-section">
        <h2>Configurar Ingreso o Gasto Fijo</h2>
        <form action="/fixed-expenses/add" method="POST" class="transaction-form">

            <div class="form-row">
                <input type="text" name="title" placeholder="Concepto (ej: Luz / Sueldo)" required>
                <!-- Quitamos el 'required' de aquí para que sea opcional -->
                <input type="number" step="0.01" name="amount" placeholder="Monto estimado ($ opcional)">
                <input type="number" min="1" max="31" name="due_day" placeholder="Día (1-31)" required>
            </div>
            <div class="form-row options-row" style="margin-top: 10px;">
                <select name="type" required style="padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 100%;">
                    <option value="expense">Gasto Fijo</option>
                    <option value="income">Ingreso Fijo</option>
                </select>
            </div>

            <button type="submit" class="btn-submit" style="margin-top: 10px;">Guardar Fijo Recurrente</button>
        </form>
    </section>

    <section class="transactions-section">
        <h2>Movimientos Fijos Activos</h2>
        <% if (fixedExpenses && fixedExpenses.length > 0) { %>
            <div class="table-responsive">
                <table class="transactions-table">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th>Tipo</th>
                            <th>Monto</th>
                            <th>Vencimiento / Aplicación</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% fixedExpenses.forEach(item => { %>
                            <tr>
                                <td><%= item.title %></td>
                                <td>
                                    <span class="badge <%= item.type === 'income' ? 'income' : 'expense' %>">
                                        <%= item.type === 'income' ? 'Ingreso Fijo' : 'Gasto Fijo' %>
                                    </span>
                                </td>
                                <td class="<%= item.type === 'income' ? 'income' : 'expense' %>">
                                    $<%= parseFloat(item.amount).toFixed(0) %>
                                </td>
                                <td>Día <%= item.due_day %> del mes</td>
                                <td>
                                    <form action="/fixed-expenses/delete/<%= item.id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn-delete" onclick="return confirm('¿Borrar?')">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="no-data">No hay movimientos fijos configurados.</p>
        <% } %>
    </section>
</div>

<%- include('partials/footer') %>