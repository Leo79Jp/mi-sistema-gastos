<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control de Gastos</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Ícono para la pantalla de inicio en Android / Chrome -->
    <link rel="icon" type="image/png" href="/img/icono-gastos1.ico">
    <link rel="apple-touch-icon" href="/img/icono-gastos1.ico">

    <!-- Color de la barra de navegación del navegador móvil (opcional, combina con tu diseño) -->
    <meta name="theme-color" content="#333333">
</head>
<body>

<!-- Navbar Superior -->
<!-- Navbar Superior -->
<nav class="navbar">
    <div class="nav-brand">
        <a href="/dashboard">💰 Control de Gastos</a>
    </div>

    <!-- Contenedor derecho para móvil (Avatar/Inicial + Botón Hamburguesa) -->
    <div class="nav-right-mobile">
        <% if (locals.email) { %>
            <!-- Mostramos la inicial del email en mayúscula -->
            <span class="user-initial-badge" title="<%= email %>">
                <%= email.charAt(0).toUpperCase() %>
            </span>
        <% } %>

        <!-- Botón Hamburguesa -->
        <button class="hamburger-btn" id="hamburgerBtn" aria-label="Abrir menú">
            ☰
        </button>
    </div>
    
    <!-- Enlaces del menú desplegable -->
    <div class="nav-links" id="navLinks">
        <% if (locals.email) { %>
            <a href="/dashboard" class="nav-link">Dashboard</a>
            <a href="/movements" class="nav-link">Movimientos</a>
            <a href="/fixed-expenses" class="nav-link">Fijos</a>
            <span class="nav-user">Conectado como: <%= email %></span>
            <a href="/auth/logout" class="btn-logout">Salir</a>
        <% } %>
    </div>
</nav>

<!-- Script mejorado para abrir y cerrar el menú hamburguesa en celular y PC -->

<script>
    (function() {
        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const navLinks = document.getElementById('navLinks');

        if (hamburgerBtn && navLinks) {
            hamburgerBtn.addEventListener('click', () => {
                navLinks.classList.toggle('active');
            });

            // Cerrar menú al hacer clic en cualquier opción del menú
            const navItems = navLinks.querySelectorAll('a');
            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    navLinks.classList.remove('active');
                });
            });
        }
    })();
</script>

    <!-- Contenedor Principal -->
    <main class="main-content">