<%- include('partials/header') %>

<div class="dashboard-container">

    <!-- Botón de acceso rápido a Movimientos -->
    <!-- <div style="margin-bottom: 20px; text-align: right;">
        <a href="/movements" class="btn-submit" style="text-decoration: none; display: inline-block; width: auto; padding: 12px 20px; background-color: #007bff; font-weight: bold;">
            ➕ Ver y Agregar Movimientos
        </a>
    </div> -->

    <!-- Tarjetas de Resumen -->
<section class="summary-cards">
        <div class="card income">
            <span class="card-label">Ingresos</span>
            <p>$<%= Math.round(totals.totalIncome) %></p>
        </div>
        <div class="card expense">
            <span class="card-label">Gastos</span>
            <p>$<%= Math.round(totals.totalExpense) %></p>
        </div>
        <div class="card balance <%= totals.balance >= 0 ? 'positive' : 'negative' %>">
            <span class="card-label">Balance</span>
            <p>$<%= Math.round(totals.balance) %></p>
        </div>
    </section>

    <!-- Gráfico de Evolución -->
    <section class="chart-section" style="background: #fff; padding: 15px; border-radius: 6px; margin-bottom: 0px; border: 1px solid #eee;">
        <h3 style="margin-top: 0; font-size: 16px; color: #444; text-align: center;">Evolución Financiera (6 Meses)</h3>
        <div style="position: relative; height: 300px; width: 100%;">
            <canvas id="financeChart" 
                data-labels="<%= JSON.stringify(chart.labels) %>"
                data-incomes="<%= JSON.stringify(chart.incomes) %>"
                data-expenses="<%= JSON.stringify(chart.expenses) %>">
            </canvas>
        </div>
    </section>

</div>

<!-- Cargar Chart.js desde CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const canvasElement = document.getElementById('financeChart');
    if (canvasElement) {
        const chartLabels = JSON.parse(canvasElement.dataset.labels || '[]');
        const chartIncomes = JSON.parse(canvasElement.dataset.incomes || '[]');
        const chartExpenses = JSON.parse(canvasElement.dataset.expenses || '[]');

        const ctx = canvasElement.getContext('2d');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        label: 'Ingresos',
                        data: chartIncomes,
                        backgroundColor: 'rgba(40, 167, 69, 0.7)',
                        borderColor: 'rgba(40, 167, 69, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Gastos',
                        data: chartExpenses,
                        backgroundColor: 'rgba(220, 53, 69, 0.7)',
                        borderColor: 'rgba(220, 53, 69, 1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }
</script>

<%- include('partials/footer') %>